# =============================================================================
# Jerry — Monorepo .gitignore
# Covers: Next.js (web/), Node.js scripts, database tooling, macOS, and IDEs
# =============================================================================

# ─── Secrets & Environment Variables ─────────────────────────────────────────
# NEVER commit API keys, database credentials, or admin secrets.
.env
.env.local
.env.development
.env.production
.env*.local
web/.env
web/.env.local
web/.env.development
web/.env.production
web/.env*.local

# ─── Node.js / npm ───────────────────────────────────────────────────────────
node_modules/
web/node_modules/
functions/node_modules/
scripts/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Lock files (keep package-lock.json in web/ but ignore loose ones)
# Uncomment to ignore all lock files:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ─── Next.js Build Output ─────────────────────────────────────────────────────
web/.next/
web/out/
web/build/

# Turbopack cache
.turbo/
web/.turbo/

# Next.js typegen — auto-generated by the framework, not source
web/next-env.d.ts

# TypeScript incremental compilation info
*.tsbuildinfo
web/*.tsbuildinfo

# ─── Production / CI Artifacts ────────────────────────────────────────────────
dist/
.vercel/
.netlify/

# ─── Database ─────────────────────────────────────────────────────────────────
# Local Nhost instance data — never commit
.nhost/
nhost/.nhost/

# Local PostgreSQL dump files
*.dump
*.sql.gz
*.backup

# Seed output logs
db/seed-output.log

# ─── Testing & Coverage ───────────────────────────────────────────────────────
coverage/
web/coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.icloud

# ─── IDE & Editors ───────────────────────────────────────────────────────────
# VS Code (keep shared workspace settings if needed: !.vscode/settings.json)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (IntelliJ, WebStorm, etc.)
.idea/
*.iml
*.ipr
*.iws
out/

# Vim / Neovim
*.swp
*.swo
*~
.vim/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Emacs
*#
.#*

# ─── Certificates & Keys ──────────────────────────────────────────────────────
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
pids/
*.pid
*.seed
*.pid.lock

# ─── Temporary Files ──────────────────────────────────────────────────────────
tmp/
temp/
.tmp/
.cache/

# ─── Yarn ────────────────────────────────────────────────────────────────────
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*
