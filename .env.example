# JerryPay — Next.js Frontend Environment Variables
# Copy to .env.local and fill in your real values.
# NEVER commit .env.local to source control.

# ── Nhost Project ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_NHOST_SUBDOMAIN=YOUR_NHOST_SUBDOMAIN
NEXT_PUBLIC_NHOST_REGION=ap-south-1   # e.g. eu-central-1, us-east-1

# ── Hasura (used server-side only; never expose admin secret to the client) ───
NHOST_GRAPHQL_URL=https://YOUR_NHOST_SUBDOMAIN.nhost.run/v1/graphql
NHOST_ADMIN_SECRET=YOUR_HASURA_ADMIN_SECRET

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: gemini | groq | openrouter
LLM_PROVIDER=gemini
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_DEFAULT_MODEL=gemini-1.5-flash

# Provider base URLs (defaults shown — override only if needed)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_URL=https://api.groq.com/openai/v1
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# ── Jerry Serverless Functions Base URL ───────────────────────────────────────
# Used by the Next.js app to call Nhost serverless functions
NEXT_PUBLIC_FUNCTIONS_URL=https://YOUR_NHOST_SUBDOMAIN.nhost.run/v1/functions

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
